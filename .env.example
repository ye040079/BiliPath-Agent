# ===== Copy this file to .env and fill in your real values =====
# .env is git-ignored; .env.example is a tracked TEMPLATE with a placeholder key only.
# NEVER put a real API key in .env.example.

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Service port (optional, default 7860)
PORT=7860

# Whether to allow public registration
# Demo: register your own account first, then set to false and restart
ALLOW_REGISTER=true

# Admin username for official knowledge base management (must match a registered user)
# Leave empty to disable the admin panel
ADMIN_USERNAME=admin

# Auto-publish newly generated plans into the shared knowledge base
# Set false when public registration is open, to keep the shared KB clean
AUTO_PUBLISH_OFFICIAL=true
